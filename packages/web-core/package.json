  "private": true,
  "type": "module",
  "description": "Auth (Keycloak), tenant slug, Apollo client, token refresh, REST helpers shared by apps/web and apps/portal",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
