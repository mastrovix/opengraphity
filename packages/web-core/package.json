  "devDependencies": {
    "@apollo/client": "^4.3.0",
    "@opengraphity/types": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "graphql": "^17.0.2",
    "jsdom": "^30.1.0",
    "keycloak-js": "^26.2.4",
    "react": "^19.3.0",
