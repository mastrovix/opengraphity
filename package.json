{
  "name": "opengraphity",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive --if-present --filter '!opengraphity' test",
    "lint": "eslint 'apps/*/src/**/*.{ts,tsx}' 'packages/*/src/**/*.ts'",
    "typecheck": "pnpm --recursive exec tsc --noEmit",
    "vocabolario:log": "node scripts/genera-vocabolario-log.mjs",
    "check:vocabolario": "node scripts/genera-vocabolario-log.mjs --check",
    "neo4j:init": "pnpm --filter @opengraphity/api migrate -- --init-schema",
    "deploy:web": "pnpm --filter @opengraphity/web build && docker compose -f infra/docker-compose.yml up -d --build web",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4",
      "@types/d3-selection": "3.0.11",
      "@types/express": "^5.0.6",
      "ip-address": "^10.7.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "isolated-vm",
      "msgpackr-extract",
      "sharp",
      "onnxruntime-node",
      "protobufjs"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "graphql": "17"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "catalog:"
  }
}
