# ── OpenGraphity environment ──────────────────────────────────────────────────
# Copy to infra/.env and fill in your values:
#   cp infra/.env.example infra/.env
#
# This file documents EVERY variable the runtime code reads (apps/api and
# packages/*) plus the few consumed only by docker-compose / the frontend
# builds. `node scripts/check-env-example.mjs` (run in CI) fails when the code
# and this file diverge, so a new variable must be added here with a comment.
#
# docker-compose.yml has NO default for the secrets (`${VAR:?...}`): `docker
# compose up` refuses to start while any of them is missing or empty. The
# `change-me-*` values are placeholders, not working defaults — replace every
# one of them before the first start.
#
# Development defaults (localhost, ./data, the local Neo4j password) exist
# ONLY when NODE_ENV != production: with NODE_ENV=production the API refuses
# to start and lists every missing variable (apps/api/src/lib/config.ts).

# ── Required secrets (no defaults in docker-compose.yml) ─────────────────────
# Signs the legacy dev JWTs (see ALLOW_LEGACY_JWT) — long random string
JWT_SECRET=change-me-jwt-secret
# Password of the `neo4j` user: sets NEO4J_AUTH in the neo4j service AND is
# the password the api/worker connect with — one variable, one value
NEO4J_PASSWORD=change-me-neo4j-password
# Redis password: `redis-server --requirepass` in the redis service AND the
# password api/worker connect with (see REDIS_URL / REDIS_PASSWORD below)
REDIS_PASSWORD=change-me-redis-password
# Keycloak master-realm admin: the API uses it to create users in any tenant
# realm (createUser), the onboarding/add-user scripts and
# infra/scripts/update-keycloak-redirects.sh too
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
# Grafana `admin` password (compose only: GF_SECURITY_ADMIN_PASSWORD). Applied
# on the FIRST start of the grafana_data volume; afterwards change it in the UI.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

# ── Front-door nginx (compose only — rendered into infra/nginx/default.conf.template)
# Hostname of the Tailscale HTTPS front door (`tailscale serve` → nginx:80).
# Used as server_name of the remote-access block and in the CSP connect-src
# of the *.localhost blocks (https://$TAILSCALE_HOST).
TAILSCALE_HOST=macbook-pro-di-vittorio.tailcf0f55.ts.net
# Keycloak origin the browser talks to, allowed by the CSP of the *.localhost
# blocks (one origin; KEYCLOAK_PUBLIC_URL below may list more for the API)
KEYCLOAK_PUBLIC_ORIGIN=http://localhost:8080
# Tenant host the Tailscale front door forwards as X-Forwarded-Host (the
# Tailscale hostname carries no tenant slug)
TAILSCALE_TENANT_HOST=c-one.localhost

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | test | production. The compose file sets production for api and
# worker; put development in apps/api/.env for `pnpm dev`.
NODE_ENV=development
# HTTP port of the API (compose: 4000)
PORT=4000
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Process profile (apps/api/src/lib/workerProfiles.ts — revisione 2 · D1.1):
#   all    = the API process runs every worker (default for `pnpm dev`);
#            in the worker process = the embedding worker (compose `worker`)
#   api    = the API runs HTTP + ITSM workers only (compose `api`)
#   events = the worker process runs the Event Management / Servizi monitorati
#            workers and the service-impact consumer (compose `events-worker`)
# The compose file sets it per service; a profile not valid for the process
# (api on worker.ts, events on index.ts) stops the boot.
WORKER_PROFILE=all

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# bolt://neo4j:7687 inside Docker, bolt://localhost:7687 for `pnpm dev`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Connections the driver may hold open, per process (default 50). The compose
# file sizes it per service: api 50 (HTTP + ITSM workers), events-worker 40
# (12 job slots × up to 3 sessions per event). Positive integer.
NEO4J_MAX_POOL_SIZE=50

# ── Redis (one parser for the whole platform: packages/events/src/redis.ts) ──
# Preferred form. The password may be embedded (redis://:pw@host:6379) or given
# separately with REDIS_PASSWORD (above). rediss:// enables TLS.
# Docker: redis://redis:6379 — local dev: redis://localhost:6379
REDIS_URL=redis://localhost:6379
# Alternative to REDIS_URL (ignored when REDIS_URL is set)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Internal URL for server-to-server calls (JWKS fetch, admin API):
# http://keycloak:8080 inside Docker, http://localhost:8080 for `pnpm dev`
KEYCLOAK_URL=http://localhost:8080
# Public URL(s) that browsers use to reach Keycloak — the API accepts a token
# only if its `iss` origin is in this list (or is KEYCLOAK_URL). Comma-separated
# when the same API serves more than one front door, e.g. local + Tailscale:
#   KEYCLOAK_PUBLIC_URL=http://localhost:8080,https://my-host.tailnet.ts.net
# In production set your public Keycloak domain (e.g. https://auth.example.com).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Master-realm admin username (password: KEYCLOAK_ADMIN_PASSWORD above)
KEYCLOAK_ADMIN_USER=admin

# ── Auth options ──────────────────────────────────────────────────────────────
# true → the API also accepts HS256 tokens signed with JWT_SECRET (dev/scripts
# only: gen-token.ts, load tests). Leave false in production.
ALLOW_LEGACY_JWT=false

# ── HTTP / GraphQL ────────────────────────────────────────────────────────────
# Allowed browser origins (comma-separated, `*.` wildcard per label). Required
# in production: the server refuses to start without it.
CORS_ORIGIN=http://*.localhost,http://localhost:5173,http://localhost:5174,http://localhost
# Requests per minute per client for the GraphQL rate limiter (production only;
# outside production the limit is always 1000)
RATE_LIMIT_MAX=1000
# true → Apollo introspection/Sandbox stays enabled with NODE_ENV=production.
# The compose stack defaults to false (safe): set true here to use the Sandbox
# on the local stack; keep false on a real deployment.
GRAPHQL_INTROSPECTION=false
# GET /metrics (Prometheus): when set, the scraper must send
# `Authorization: Bearer <METRICS_TOKEN>` — the compose `prometheus` service
# reads this same variable. When empty, /metrics answers only to loopback and
# private/docker networks (judged on the socket address), which is where the
# Prometheus container lives.
METRICS_TOKEN=
# Base URL of the web app used in every outbound link (emails, Slack/Teams cards)
APP_URL=http://localhost

# ── Storage (absolute paths inside the container: /data/… on the api_data volume;
# /data/backups is its own volume, api_backups — see docs/DEPLOY.md "Backup")
ATTACHMENT_DIR=./data/attachments
BACKUP_DIR=./backups
REPORT_DIR=./data/reports
# Nightly backup rotation (maintenance worker): archives kept, integer >= 1
BACKUP_RETENTION=14
# true → the backup skips the Keycloak realm export knowingly (no admin access)
BACKUP_SKIP_KEYCLOAK=false

# ── Discovery ─────────────────────────────────────────────────────────────────
# 32-byte hex key encrypting connector credentials at rest (optional: without
# it discovery sources with credentials cannot be saved)
DISCOVERY_ENCRYPTION_KEY=

# ── Embeddings (semantic similarity: similar incidents + suggested KB) ────────
# local  = Transformers.js ONNX in-process (default, no external service)
# voyage = Voyage AI API (requires VOYAGE_API_KEY)
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=
# Model cache for the local provider (~120 MB on first use; /data/models in Docker)
TRANSFORMERS_CACHE=./data/models
# true → the API does not run the embedding worker in-process because the
# dedicated `worker` container does (compose sets it)
EMBEDDING_WORKER_EXTERNAL=false

# ── Email (Resend) — packages/notifications ───────────────────────────────────
# Empty = mock mode (emails logged, not sent). Required in production.
RESEND_API_KEY=
EMAIL_FROM=OpenGrafo <onboarding@resend.dev>

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
# OTLP/HTTP traces endpoint (compose: http://jaeger:4318/v1/traces); read only when OTEL_ENABLED=true
OTEL_ENDPOINT=http://localhost:4318/v1/traces

# ── Optional integrations (features stay off when empty) ──────────────────────
# AI assistant / triage / post-incident / report AI
# Modello Claude di tutti i servizi AI (triage, assistente, post-incident,
# agente dei report). Default: claude-opus-5. REPORT_AI_MODEL scavalca il solo
# agente dei report, che interroga il grafo con gli strumenti.
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
# Claude model used by the report agent (services/reportAgent.ts); empty = its built-in default
REPORT_AI_MODEL=
# Slack bot token for channel notifications (chat.postMessage) and signing
# secret for the inbound /slack endpoint
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=


# ── Frontend build args ───────────────────────────────────────────────────────
# NB: the `web` image COPIES apps/web/dist and does NOT build it: these values
# must be in the environment of the LOCAL `pnpm --filter @opengraphity/web build`
# (e.g. `set -a; . infra/.env; set +a`). apps/web/.env.local wins over them if
# present. Only the portal image reads them as Docker build args.
# Keycloak URL reachable by the browser (not internal Docker hostname)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_CLIENT_ID=opengrafo-web
VITE_KEYCLOAK_CLIENT_ID_PORTAL=opengrafo-portal
# Tenant slug shown in the portal when not using subdomain routing
VITE_TENANT_SLUG=
