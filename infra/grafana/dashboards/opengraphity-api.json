{
  "uid": "opengraphity-api",
  "title": "OpenGraphity API",
  "description": "Provisioned from infra/grafana/dashboards (metrics: apps/api/src/middleware/metrics.ts). Resolver errors are NOT exported to Prometheus yet (only via the admin GraphQL metrics): the error panel uses HTTP 5xx.",
  "tags": ["opengraphity", "provisioned"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Richieste/s per status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status_code) (rate(http_requests_total[5m]))", "legendFormat": "{{status_code}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errori HTTP 5xx/s",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) or vector(0)", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latenza p95 /graphql",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 2 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/graphql\"}[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latenza /graphql (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/graphql\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/graphql\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/graphql\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Resolver più lenti (p95, top 10)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum by (le, resolver) (rate(graphql_resolver_duration_seconds_bucket[5m]))))", "legendFormat": "{{resolver}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Code BullMQ (waiting / active / delayed / failed)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "bullmq_queue_depth{status=~\"waiting|active|delayed|failed\"}", "legendFormat": "{{queue}} {{status}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Neo4j: latenza p95 e query lente (> 500 ms)/s",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "query lente/s" }, "properties": [ { "id": "unit", "value": "ops" }, { "id": "custom.axisPlacement", "value": "right" } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(neo4j_query_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "sum(rate(neo4j_query_duration_seconds_count[5m])) - sum(rate(neo4j_query_duration_seconds_bucket{le=\"0.5\"}[5m]))", "legendFormat": "query lente/s" }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Ore dall'ultimo backup verificato",
      "description": "opengrafo_backup_last_success_timestamp_seconds — rosso oltre 25 h (backup notturno mancato o non verificato)",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "noValue": "mai",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 25 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "(time() - max(opengrafo_backup_last_success_timestamp_seconds)) / 3600", "legendFormat": "ore" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Backup per esito (ultime 24 h)",
      "gridPos": { "x": 8, "y": 24, "w": 16, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (increase(opengrafo_backup_runs_total[24h]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Event Management",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Eventi/s per esito",
      "description": "events_received_total (tutti i connettori), events_deduplicated_total (ripetizioni della stessa impronta), events_suppressed_total (finestra di change), events_flapping_total (ingressi in sfarfallio) — services/eventService.ts, eventCorrelation.ts",
      "gridPos": { "x": 0, "y": 31, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(events_received_total[5m]))", "legendFormat": "ricevuti" },
        { "refId": "B", "expr": "sum(rate(events_deduplicated_total[5m]))", "legendFormat": "deduplicati" },
        { "refId": "C", "expr": "sum(rate(events_suppressed_total[5m]))", "legendFormat": "soppressi" },
        { "refId": "D", "expr": "sum(rate(events_flapping_total[5m]))", "legendFormat": "sfarfallio" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Incident automatici al minuto (aperti / risolti / riaperti)",
      "description": "incidents_auto_opened_total (correlazione e incident di tempesta), incidents_auto_resolved_total, incidents_reopened_total — services/eventCorrelation.ts, eventStorm.ts",
      "gridPos": { "x": 10, "y": 31, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(incidents_auto_opened_total[1m]))", "legendFormat": "aperti" },
        { "refId": "B", "expr": "sum(increase(incidents_auto_resolved_total[1m]))", "legendFormat": "risolti" },
        { "refId": "C", "expr": "sum(increase(incidents_reopened_total[1m]))", "legendFormat": "riaperti" }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Tempeste di allarmi attive",
      "description": "event_storms_active — sorgenti (InboundWebhook) con storm_since valorizzato; in tempesta la correlazione aggancia tutto a un solo incident per sorgente (docs/OPERATIONS.md §7)",
      "gridPos": { "x": 18, "y": 31, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "max(event_storms_active) or vector(0)", "legendFormat": "tempeste" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Salute dell'Event Management",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Orfani e ambigui al minuto",
      "description": "events_orphan_total (allarme senza CI riconosciuto) ed events_ambiguous_total (più CI con lo stesso nome: l'allarme resta orfano) — revisione 2 · D7.1. Se crescono: alias/nomi dei CI non allineati con il monitoraggio (docs/OPERATIONS.md §7 «Evento orfano»)",
      "gridPos": { "x": 0, "y": 40, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(events_orphan_total[5m])) * 60", "legendFormat": "orfani/min" },
        { "refId": "B", "expr": "sum(rate(events_ambiguous_total[5m])) * 60", "legendFormat": "ambigui/min" }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Quota di allarmi orfani (15 m)",
      "description": "rate(events_orphan_total[15m]) / rate(events_received_total[15m]) — sopra il 20% scatta EventOrphanRatioHigh (infra/prometheus/alerts.yml)",
      "gridPos": { "x": 8, "y": 40, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.2 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(events_orphan_total[15m])) / sum(rate(events_received_total[15m]))) or vector(0)", "legendFormat": "orfani" }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Allarmi persi (ultima ora)",
      "description": "events_ingest_failed_total{connector}: job events-ingest falliti all'ultimo tentativo (la sorgente porta last_error; rigioco da Amministrazione → Code). events_failed_total{queue,type}: eventi di dominio esauriti nei consumer (notifica non inviata, SLA non avviato, mappa non rivalutata) — NON rigiocabili dalla console",
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (connector) (increase(events_ingest_failed_total[1h]))", "legendFormat": "ingest falliti · {{connector}}" },
        { "refId": "B", "expr": "sum by (queue) (increase(events_failed_total[1h]))", "legendFormat": "eventi persi · {{queue}}" }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Allarmi senza incident",
      "description": "events_overdue_delayed (ritardo di apertura scaduto senza job correlate) ed events_firing_uncorrelated (firing senza esito da più di 15 min). Entrambi vengono ripresi dalla passata `pending` di events-maintenance: se restano > 0 per due giri la passata sta fallendo (pannello accanto)",
      "gridPos": { "x": 0, "y": 48, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "max(events_overdue_delayed)", "legendFormat": "delayed scaduti" },
        { "refId": "B", "expr": "max(events_firing_uncorrelated)", "legendFormat": "firing senza esito" }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Passate periodiche fallite ed errori di correlazione (ultima ora)",
      "description": "event_pass_total{pass,result=\"failed\"} (closed_windows | pending | flapping | storms | gauges) ed events_correlated_total{outcome=\"error\"} (la pipeline ha lanciato: il job ritenta)",
      "gridPos": { "x": 8, "y": 48, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (pass) (increase(event_pass_total{result=\"failed\"}[1h]))", "legendFormat": "passata fallita · {{pass}}" },
        { "refId": "B", "expr": "sum(increase(events_correlated_total{outcome=\"error\"}[1h]))", "legendFormat": "errori pipeline" }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Ritardi in coda (p95)",
      "description": "event_ingest_lag_seconds (ricezione dal webhook → inizio ingest: coda events-ingest in affanno o worker fermo), event_correlate_job_lag_seconds (scadenza del ritardo → job correlate), service_evaluation_lag_seconds (accodamento → valutazione della mappa)",
      "gridPos": { "x": 16, "y": 48, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(event_ingest_lag_seconds_bucket[5m])))", "legendFormat": "ingest" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(event_correlate_job_lag_seconds_bucket[5m])))", "legendFormat": "correlate" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(service_evaluation_lag_seconds_bucket[5m])))", "legendFormat": "valutazione servizi" }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Sincronizzazioni delle mappe per esito (al minuto)",
      "description": "service_map_syncs_total{result}: changed (composizione cambiata), unchanged (solo synced_at), skipped_limit (proposta oltre i 500 nodi: nulla applicato, mappa stale), error (il job ritenta) — services/serviceImpact/sync.ts",
      "gridPos": { "x": 0, "y": 56, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(service_map_syncs_total[5m])) * 60", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Lock Redis: attese scadute (15 m) e sezione critica p95",
      "description": "redis_lock_timeouts_total{lock} (il job ritenta con backoff) e redis_lock_hold_seconds{lock}: famiglie events:group, events:storm-open, services:incident. Una sezione critica vicina ai 30 s del TTL dice che il lock scade sotto il lavoro (D2.6)",
      "gridPos": { "x": 8, "y": 56, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (lock) (increase(redis_lock_timeouts_total[15m]))", "legendFormat": "timeout · {{lock}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, lock) (rate(redis_lock_hold_seconds_bucket[5m])))", "legendFormat": "p95 hold · {{lock}}" }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Job falliti per coda",
      "description": "bullmq_queue_depth{status=\"failed\"} per ogni coda del registro (lib/queueRegistry.ts): comprese events-*, services-impact e le quattro code dei consumer di dominio. Rigioco da Amministrazione → Code dove la coda è rigiocabile",
      "gridPos": { "x": 16, "y": 56, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "max by (queue) (bullmq_queue_depth{status=\"failed\"}) > 0", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Servizi monitorati",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 64, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Mappe dei servizi per salute",
      "description": "services_health{health} — mappe per salute su tutti i tenant, riallineato ogni 5 minuti dalla passata `services-periodic` (jobs/serviceImpactWorker.ts, services/serviceImpact/engine.ts#refreshServiceGauges)",
      "gridPos": { "x": 0, "y": 65, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "giù" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "degradati" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "refId": "A", "expr": "sum(services_health{health=\"down\"}) or vector(0)", "legendFormat": "giù" },
        { "refId": "B", "expr": "sum(services_health{health=\"degraded\"}) or vector(0)", "legendFormat": "degradati" },
        { "refId": "C", "expr": "sum(services_health{health=\"maintenance\"}) or vector(0)", "legendFormat": "in manutenzione" },
        { "refId": "D", "expr": "sum(services_health{health=\"unknown\"}) or vector(0)", "legendFormat": "sconosciuti" },
        { "refId": "E", "expr": "sum(services_health{health=\"operational\"}) or vector(0)", "legendFormat": "operativi" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Valutazioni delle mappe per esito",
      "description": "rate(service_evaluations_total[5m]) — una valutazione per (mappa, innesco): changed = salute cambiata (voce di cronologia + service.health_changed), unchanged, error (il job ritenta e la passata periodica rivaluta comunque) — services/serviceImpact/engine.ts",
      "gridPos": { "x": 8, "y": 65, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(service_evaluations_total[5m]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Valutazione: durata e ritardo in coda (p95)",
      "description": "p95 di service_evaluation_duration_seconds (lettura + regole + scrittura, services/serviceImpact/engine.ts#evaluateServiceMap) e di service_evaluation_lag_seconds (secondi fra l'istante in cui il job era atteso — accodamento + 2 s di dedup — e l'inizio della valutazione, jobs/serviceImpactWorker.ts): un ritardo che cresce dice «coda services-impact in affanno», non «valutazione lenta»",
      "gridPos": { "x": 16, "y": 65, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(service_evaluation_duration_seconds_bucket[5m])) by (le))", "legendFormat": "durata p95" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(service_evaluation_lag_seconds_bucket[5m])) by (le))", "legendFormat": "ritardo in coda p95" }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Incident di servizio al minuto (aperti / risolti)",
      "description": "rate(service_incidents_opened_total[5m]) e rate(service_incidents_resolved_total[5m]) — services/serviceImpact/incident.ts; una RIAPERTURA conta come apertura (il servizio è di nuovo fuori servizio), una chiusura automatica saltata (nessun cammino verso «risolto» dal passo corrente) non conta come risolta",
      "gridPos": { "x": 0, "y": 73, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(service_incidents_opened_total[5m])) * 60", "legendFormat": "aperti" },
        { "refId": "B", "expr": "sum(rate(service_incidents_resolved_total[5m])) * 60", "legendFormat": "risolti" }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Mappe da rivedere",
      "description": "service_maps_stale — mappe con stale = true: un componente incluso non esiste più nella CMDB (la INCLUDES è caduta con il CI). La valutazione prosegue sui nodi rimasti; si sistema da «Aggiorna mappa» togliendo gli id spariti (serviceMapProposal + applyServiceMapProposal), vedi docs/OPERATIONS.md §Servizi monitorati",
      "gridPos": { "x": 18, "y": 73, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "max(service_maps_stale) or vector(0)", "legendFormat": "mappe stale" }
      ]
    }
  ]
}
