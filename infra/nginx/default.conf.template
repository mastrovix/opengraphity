# ── Template, not a config ────────────────────────────────────────────────────
# Rendered by the nginx image entrypoint (20-envsubst-on-templates.sh) from
# /etc/nginx/templates/default.conf.template into /etc/nginx/conf.d/default.conf.
# envsubst replaces ONLY the variables listed in NGINX_ENVSUBST_FILTER
# (docker-compose.yml): ${TAILSCALE_HOST}, ${KEYCLOAK_PUBLIC_ORIGIN},
# ${TAILSCALE_TENANT_HOST}. nginx's own $host, $remote_addr, $upstream_* etc.
# are left untouched. To check the rendered file:
#   docker compose -f infra/docker-compose.yml exec nginx cat /etc/nginx/conf.d/default.conf
#
# ── Common proxy headers ──────────────────────────────────────────────────────
# Defined as a reusable snippet via map/include is not available in conf.d,
# so headers are repeated per location below.
#
# NOTE: proxy_pass uses $variables so that DNS resolution is deferred to
# request time (using the Docker embedded resolver 127.0.0.11) rather than
# resolved once at nginx startup — preventing "host not found in upstream"
# when sibling containers start after nginx.
#
# SECURITY: every location that reaches the API sets X-Forwarded-Host to $host
# explicitly. The API derives the tenant of the request from that header
# (auth/resolveAuth.ts cross-checks it against the token's realm): if nginx
# forwarded the client's own value a caller could pick the tenant by header.
# client_max_body_size on /api/ comes from NGINX_API_MAX_BODY (compose,
# default 101m), kept just above ATTACHMENT_MAX_MB_CAP so the API — not nginx —
# is what refuses an oversized upload, with its own JSON message. Revisione
# totale · H-11: it used to be a fixed 11m «matching the API's 10 MB limit»,
# from before the maximum became a per-organization setting up to 100 MB.

# ── Platform console: opengrafo-admin.localhost ───────────────────────────────
# La console crea, rinomina, sospende e CANCELLA i tenant: non appartiene a
# nessuno di loro e vive su un host suo.
#
# Il `server_name` è ESATTO, non una regex, e questo è ciò che lo protegge:
# nginx preferisce sempre un nome esatto a una espressione regolare, quindi
# vince su `~^(?<tenant>[^.]+)\.localhost$` — che altrimenti corrisponderebbe
# anche qui e tratterebbe la console come un tenant chiamato «opengrafo-admin».
# Sta comunque scritto prima, perché si legge nell'ordine in cui si ragiona.
#
# La seconda metà della protezione è nell'API: `resolveAuth` rifiuta un token
# di tenant presentato su questo host, così il confine non dipende da nginx.
#
# Non c'è `/graphql`: lo schema del prodotto è legato a un tenant e la console
# non ne ha uno. Solo `/platform`, che ha la sua autenticazione (realm dedicato
# + questo host, `apps/api/src/auth/platformAuth.ts`).
server {
    listen 80;
    server_name opengrafo-admin.localhost;

    # Il DNS di Docker: `proxy_pass` con una variabile lo richiede, e senza
    # questa riga l'inoltro dava 502 — visto dal vivo appena scritto il blocco.
    resolver 127.0.0.11 ipv6=off valid=30s;

    large_client_header_buffers 4 32k;
    proxy_buffer_size           128k;
    proxy_buffers               4 256k;
    proxy_busy_buffers_size     256k;

    # Le stesse intestazioni delle altre app, più `noindex`: è un pannello di
    # servizio, non una pagina da trovare. Niente `wasm-unsafe-eval`: la console
    # non esegue formule, quindi non le serve.
    #
    # `connect-src` elenca ENTRAMBE le origini pubbliche di Keycloak, come i
    # blocchi di web e portale. Scritto più stretto — solo
    # `${KEYCLOAK_PUBLIC_ORIGIN}` — la console si fermava all'avvio con «Cannot
    # reach Keycloak … Load failed»: il bundle è costruito con
    # `VITE_KEYCLOAK_URL`, che qui è l'host Tailscale, e il CSP bloccava la
    # richiesta prima che partisse. Un CSP più severo del necessario non è più
    # sicuro: è solo rotto in un modo che somiglia a un guasto di rete.
    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ${KEYCLOAK_PUBLIC_ORIGIN} https://${TAILSCALE_HOST}; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        always;
    add_header X-Content-Type-Options "nosniff"                         always;
    add_header X-Frame-Options        "DENY"                            always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag           "noindex, nofollow"               always;

    location /platform {
        client_max_body_size 64k;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        # X-Forwarded-Host imposto da nginx: `platformAuth` confronta questo
        # host con quello configurato, e un client non deve poterlo scegliere.
        proxy_set_header   X-Forwarded-Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location / {
        set $upstream_console console:80;
        proxy_pass         http://$upstream_console;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# ── Portal: portal.{tenant}.localhost ────────────────────────────────────────
server {
    listen 80;
    server_name ~^portal\.(?<tenant>[^.]+)\.localhost$;

    resolver 127.0.0.11 ipv6=off valid=30s;

    large_client_header_buffers 4 32k;
    proxy_buffer_size           128k;
    proxy_buffers               4 256k;
    proxy_busy_buffers_size     256k;

    # Come l'app degli operatori, 'wasm-unsafe-eval' COMPRESO: dai moduli del
    # catalogo (ondata 6) il portale spedisce wasm — le formule dei campi
    # calcolati girano in QuickJS, un sandbox WebAssembly, ed è il modo SICURO di
    # eseguirle (niente `eval`, niente accesso alla pagina). Prima qui c'era
    # scritto «the portal ships no wasm», e il risultato era un campo calcolato
    # che nel portale restava vuoto: il CSP bloccava la compilazione del wasm.
    # La direttiva permette il wasm, NON l'eval di JavaScript.
    # connect-src elenca le origini pubbliche di Keycloak con cui parla il browser.
    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ${KEYCLOAK_PUBLIC_ORIGIN} https://${TAILSCALE_HOST}; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        always;
    add_header X-Content-Type-Options "nosniff"                      always;
    add_header X-Frame-Options        "DENY"                         always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # ── SSE — no buffering, no upgrade ──────────────────────────────────────
    location /api/sse {
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        '';
        proxy_set_header   Upgrade           '';
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 86400s;
        add_header         Cache-Control     "no-cache"           always;
    }

    # ── GraphQL ──────────────────────────────────────────────────────────────
    location /graphql {
        # H-21: senza questa riga vale il default di nginx (1 MB) e un corpo piu
        # grande tornava 413 in HTML, che Apollo Client mostra come «Network
        # error». L'API ha il suo limite (512 kB, server.ts) e risponde in JSON:
        # qui si sta piu larghi, cosi e sempre l'API a rispondere.
        client_max_body_size 2m;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }

    # ── REST API ─────────────────────────────────────────────────────────────
    location /api/ {
        # H-11: il tetto viene dall'ambiente (NGINX_API_MAX_BODY), un po' sopra
        # ATTACHMENT_MAX_MB_CAP, cosi il no lo dice l'API e non nginx in HTML.
        client_max_body_size ${NGINX_API_MAX_BODY};
        # H-20: import CSV fino a 20 MB, export PDF/Excel e /api/report-stream
        # passano il minuto del default. Un 504 qui lascia l'import a metà per
        # il client mentre l'API lo completa davvero.
        proxy_read_timeout   600s;
        proxy_send_timeout   600s;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }

    # ── Portal SPA ───────────────────────────────────────────────────────────
    location / {
        set $upstream_portal portal:80;
        proxy_pass         http://$upstream_portal;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }
}

