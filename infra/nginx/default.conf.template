# ── Accesso remoto Tailscale HTTPS (iPad) — app + Keycloak same-origin ────────
# tailscale serve termina TLS e inoltra a nginx:80 con X-Forwarded-Proto=https.
# Keycloak è proxato sotto lo stesso host per evitare mixed content e :8080.
# ${TAILSCALE_HOST} e ${TAILSCALE_TENANT_HOST} arrivano da infra/.env.
server {
    listen 80;
    server_name ${TAILSCALE_HOST};

    resolver 127.0.0.11 ipv6=off valid=30s;

    large_client_header_buffers 4 32k;
    proxy_buffer_size           128k;
    proxy_buffers               4 256k;
    proxy_busy_buffers_size     256k;

    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        always;
    # Il blocco è raggiungibile solo via TLS (tailscale serve): HSTS impedisce
    # il downgrade a http lato client.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "DENY"    always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Keycloak (login) sullo stesso origine ──────────────────────────────────
    location ~ ^/(realms|resources|admin|js|robots.txt)(/|$) {
        # Keycloak invia i propri security header: NON ereditare la CSP dell'app
        # (bloccherebbe gli script inline del login e, via form-action, il
        # redirect post-login verso il tenant host). Un add_header locale
        # disattiva l'ereditarietà di quelli a livello server.
        # (Keycloak emette già il proprio Strict-Transport-Security quando
        # X-Forwarded-Proto=https: non duplicarlo qui.)
        add_header X-Content-Type-Options "nosniff" always;
        set $upstream_kc keycloak:8080;
        proxy_pass         http://$upstream_kc;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  443;
    }

    # L'host Tailscale non porta lo slug tenant: le location API impostano
    # X-Forwarded-Host = ${TAILSCALE_TENANT_HOST} (tenant fisso di questo front-door).
    location /api/sse {
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   Connection        '';
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 86400s;
        add_header         Cache-Control     "no-cache" always;
    }
    location /graphql {
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    location /api/ {
        client_max_body_size 11m;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    location / {
        set $upstream_web web:80;
        proxy_pass         http://$upstream_web;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
}
