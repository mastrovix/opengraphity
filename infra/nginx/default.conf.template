# ── Accesso remoto Tailscale HTTPS (iPad) — app + Keycloak same-origin ────────
# tailscale serve termina TLS e inoltra a nginx:80 con X-Forwarded-Proto=https.
# Keycloak è proxato sotto lo stesso host per evitare mixed content e :8080.
# ${TAILSCALE_HOST} e ${TAILSCALE_TENANT_HOST} arrivano da infra/.env.
server {
    listen 80;
    server_name ${TAILSCALE_HOST};

    resolver 127.0.0.11 ipv6=off valid=30s;

    large_client_header_buffers 4 32k;
    proxy_buffer_size           128k;
    proxy_buffers               4 256k;
    proxy_busy_buffers_size     256k;

    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        always;
    # Il blocco è raggiungibile solo via TLS (tailscale serve): HSTS impedisce
    # il downgrade a http lato client.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "DENY"    always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Keycloak (login) sullo stesso origine ──────────────────────────────────
    # `/admin` è condiviso: la console di Keycloak vive in /admin/master/…,
    # /admin/realms/… e /admin/serverinfo, mentre /admin/monitoring,
    # /admin/audit, … sono pagine dell'app. Solo i percorsi di Keycloak vanno
    # a Keycloak; il resto di /admin/* resta al web (un caricamento diretto di
    # /admin/monitoring finiva sulla pagina "We are sorry" di Keycloak).
    location ~ ^/(realms|resources|js|robots\.txt)(/|$) {
        add_header X-Content-Type-Options "nosniff" always;
        set $upstream_kc keycloak:8080;
        proxy_pass         http://$upstream_kc;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  443;
    }
    location ~ ^/admin(/?$|/(master|realms|serverinfo)(/|$)) {
        # Keycloak invia i propri security header: NON ereditare la CSP dell'app
        # (bloccherebbe gli script inline del login e, via form-action, il
        # redirect post-login verso il tenant host). Un add_header locale
        # disattiva l'ereditarietà di quelli a livello server.
        # (Keycloak emette già il proprio Strict-Transport-Security quando
        # X-Forwarded-Proto=https: non duplicarlo qui.)
        add_header X-Content-Type-Options "nosniff" always;
        set $upstream_kc keycloak:8080;
        proxy_pass         http://$upstream_kc;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-Port  443;
    }

    # L'host Tailscale non porta lo slug tenant: le location API impostano
    # X-Forwarded-Host = ${TAILSCALE_TENANT_HOST} (tenant fisso di questo front-door).
    location /api/sse {
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   Connection        '';
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 86400s;
        add_header         Cache-Control     "no-cache" always;
    }
    location /graphql {
        # H-21: senza questa riga vale il default di nginx (1 MB) e un corpo piu
        # grande tornava 413 in HTML, che Apollo Client mostra come «Network
        # error». L'API ha il suo limite (512 kB, server.ts) e risponde in JSON:
        # qui si sta piu larghi, cosi e sempre l'API a rispondere.
        client_max_body_size 2m;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    location /api/ {
        # H-11: il tetto viene dall'ambiente (NGINX_API_MAX_BODY), un po' sopra
        # ATTACHMENT_MAX_MB_CAP, cosi il no lo dice l'API e non nginx in HTML.
        client_max_body_size ${NGINX_API_MAX_BODY};
        # H-20: import CSV fino a 20 MB, export PDF/Excel e /api/report-stream
        # passano il minuto del default. Un 504 qui lascia l'import a metà per
        # il client mentre l'API lo completa davvero.
        proxy_read_timeout   600s;
        proxy_send_timeout   600s;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    # Il portale da remoto NON sta qui sotto /portal/ (review del 23 set 2026,
    # scelta del proprietario): con `proxy_pass` a variabile ogni /portal/*
    # arrivava al portale come «/», e il bundle è costruito per la radice. Ha
    # un front-door suo, sulla porta 8081 qui sotto.

    location / {
        set $upstream_web web:80;
        proxy_pass         http://$upstream_web;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
}

# ── Portale self-service da remoto: front-door dedicato (review 23 set 2026) ──
# Scelta del proprietario: un indirizzo Tailscale suo, non /portal/ dentro
# quello del web. `tailscale serve --bg --https=8443 http://127.0.0.1:8081`
# termina TLS e inoltra qui; la porta 8081 è pubblicata solo in loopback
# (docker-compose.yml). Il bundle del portale è costruito per la radice e porta
# il suo tenant (VITE_TENANT_SLUG); le API vanno con lo stesso tenant del
# front-door web. Keycloak resta quello di ${TAILSCALE_HOST} (VITE_KEYCLOAK_URL):
# il client del portale deve accettare https://${TAILSCALE_HOST}:8443/* come
# indirizzo di ritorno (docs/DEPLOY.md).
server {
    listen 8081 default_server;
    server_name _;

    resolver 127.0.0.11 ipv6=off valid=30s;

    large_client_header_buffers 4 32k;
    proxy_buffer_size           128k;
    proxy_buffers               4 256k;
    proxy_busy_buffers_size     256k;

    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://${TAILSCALE_HOST}; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "DENY"    always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /graphql {
        client_max_body_size 2m;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    location /api/ {
        client_max_body_size ${NGINX_API_MAX_BODY};
        proxy_read_timeout   600s;
        proxy_send_timeout   600s;
        set $upstream_api api:4000;
        proxy_pass         http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-Host  ${TAILSCALE_TENANT_HOST};
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
    location / {
        set $upstream_portal portal:80;
        proxy_pass         http://$upstream_portal;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
}

# ── Host sconosciuto (revisione totale · H-32) ───────────────────────────────
# Senza un `default_server` una richiesta con `Host` che non corrisponde a
# nessun blocco cadeva nel PRIMO, il portale, che senza slug nel sottodominio
# mostrava «Nessun tenant nel sottodominio»: chi apriva http://localhost/ o
# l'IP del Mac dalla LAN vedeva l'errore di un'applicazione invece di un 404.
# Questo blocco e l'ultimo del file ma `default_server` non dipende
# dall'ordine: e lui a prendere tutto quello che nessun altro riconosce.
server {
    listen 80 default_server;
    server_name _;

    # Nessun proxy, nessun corpo: solo la risposta che dice che l'indirizzo non
    # e servito da qui. `/health` risponde 200 perche un controllo TCP/HTTP
    # sull'IP del container non deve leggersi come un guasto.
    location = /health { access_log off; add_header Content-Type text/plain always; return 200 "nginx: ok\n"; }
    location / { add_header Content-Type text/plain always; return 404 "OpenGrafo: nessuna organizzazione per questo indirizzo. Usa http://<organizzazione>.localhost (o l'host Tailscale).\n"; }
}
