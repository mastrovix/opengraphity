// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emailTemplates > snapshot di incidentCreated (layout stabile) 1`] = `
"<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#F8FAFC;font-family:Arial,Helvetica,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#F8FAFC;padding:24px 0;">
<tr><td align="center">
<table width="600" cellpadding="0" cellspacing="0" style="background:#FFFFFF;border-radius:8px;border:1px solid #E2E8F0;overflow:hidden;">
<!-- Header -->
<tr><td style="background:#0F172A;padding:16px 24px;">
<span style="color:#0EA5E9;font-size:20px;font-weight:700;">open</span><span style="color:#FFFFFF;font-size:20px;font-weight:700;">grafo</span>
<span style="color:#64748B;font-size:12px;margin-left:12px;">ACME</span>
</td></tr>
<!-- Body -->
<tr><td style="padding:24px;">
      <h2 style="margin:0 0 16px;font-size:18px;color:#0F172A;">Nuovo incident</h2>
      <table cellpadding="0" cellspacing="0" style="width:100%;">
        <tr><td style="padding:4px 0;font-size:13px;color:#64748B;width:120px;vertical-align:top;">Titolo</td><td style="padding:4px 0;font-size:13px;color:#0F172A;"><strong>Disk &lt;full&gt;</strong></td></tr>
        <tr><td style="padding:4px 0;font-size:13px;color:#64748B;width:120px;vertical-align:top;">Severità</td><td style="padding:4px 0;font-size:13px;color:#0F172A;"><span style="display:inline-block;padding:2px 10px;border-radius:4px;font-size:12px;font-weight:600;color:#FFFFFF;background:#F97316;">high</span></td></tr>
        
        <tr><td style="padding:4px 0;font-size:13px;color:#64748B;width:120px;vertical-align:top;">Descrizione</td><td style="padding:4px 0;font-size:13px;color:#0F172A;">a &amp; b</td></tr>
      </table>
      <table cellpadding="0" cellspacing="0" style="margin:16px 0;"><tr><td style="background:#0EA5E9;border-radius:6px;padding:10px 24px;">
<a href="https://app.example.test/incidents/inc-1" style="color:#FFFFFF;text-decoration:none;font-size:14px;font-weight:600;">Vedi incident</a>
</td></tr></table>
    </td></tr>
<!-- Footer -->
<tr><td style="padding:16px 24px;border-top:1px solid #E2E8F0;text-align:center;">
<span style="font-size:11px;color:#64748B;">Powered by OpenGrafo &copy; 2026</span>
</td></tr>
</table>
</td></tr></table>
</body></html>"
